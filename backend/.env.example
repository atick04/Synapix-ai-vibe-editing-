# API Keys for Synapix AI studio
GOOGLE_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
PEXELS_API_KEY=your_pexels_api_key
FREESOUND_API_KEY=your_freesound_api_key
REPLICATE_API_TOKEN=your_replicate_token

# Admin panel password (Railway → Variables). Change from default!
ADMIN_SECRET_KEY=change-me-strong-admin-password

# Persistent data (Railway volume MUST mount here)
# DATA_DIR=/app/backend/uploads
# Upload dir alias (optional)
# UPLOAD_DIR=/app/backend/uploads

# Closed-beta trial defaults (access keys from /admin)
TRIAL_KEY_DAYS=7
TRIAL_TOKENS_LIMIT=250000

# Custom Models (used if OPENROUTER_API_KEY is active)
DIRECTOR_MODEL=anthropic/claude-haiku-4.5
GRAPHICS_MODEL=google/gemini-2.5-flash-lite

# VLM via OpenRouter (production) or local LM Studio
VLM_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=qwen/qwen3-vl-32b-instruct

# Set to 1 to skip RVM weight download on boot
# SKIP_RVM_BOOTSTRAP=0

# Cloudflare R2 Storage (optional — otherwise files stay on the volume)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=synapix-videos
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Auth (required on Railway / production) ---
# Random 32+ chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
GOOGLE_CLIENT_ID=
# Comma-separated browser origins that may call the API with cookies
CORS_ORIGINS=https://synapix.ai,https://www.synapix.ai
# APP_ENV=production
# AUTH_TOKEN_DAYS=30
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_SECURE=true
# Signup emails — production MUST use Resend + synapix.ai (Gmail is local-only)
APP_ENV=production
RESEND_API_KEY=re_xxxxxxxx
SMTP_FROM=Synapix <noreply@synapix.ai>
MAIL_REPLY_TO=Synapix <hello@synapix.ai>
MAIL_LOGO_URL=https://synapix.ai/logo.png
# Local fallback only (do not set these on Railway):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=

# Founder / comps: comma-separated emails skip the 1-free-reel paywall
# UNLIMITED_EMAILS=you@synapix.ai

# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# DODO_PAYMENTS_ENVIRONMENT=test
# DODO_PRODUCT_ID=pdt_...
# DODO_TRIAL_DAYS=7
# DODO_RETURN_URL=https://synapix.ai/account?billing=success
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
# NEXT_PUBLIC_BACKEND_URL=https://your-backend.up.railway.app
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

